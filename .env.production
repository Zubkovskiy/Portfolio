# Production build settings for the GitHub Pages deployment.
#
# Committed on purpose: every value here is NEXT_PUBLIC_*, which means it is
# inlined into the JavaScript that ships to every visitor. Nothing secret can
# live in this file. The workflow can override any of it with a repository
# variable of the same name.

# Pages serves this repo at https://<user>.github.io/Portfolio.
NEXT_PUBLIC_SITE_URL=https://zubkovskiy.github.io/Portfolio
NEXT_PUBLIC_BASE_PATH=/Portfolio

# Formspree form id. Public by design — Formspree endpoints are meant to be
# posted to from the browser, and the site has no backend to hide it behind.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/mvgbdeap
